digraph schedule {

graph [fontname="DejaVu Sans", rankdir=TB, nodesep=0.23, ranksep=0.36, pad=0.16, bgcolor="white"]
node [fontname="DejaVu Sans", fontsize=11, shape=box, style="rounded,filled",
      fillcolor="#eff6f6", color="#458181", fontcolor="#123844", margin="0.11,0.075"]
edge [fontname="DejaVu Sans", fontsize=9, color="#345960", fontcolor="#17414a", arrowsize=0.68]
label="Карточки и история: стрелка от внешнего ключа к цели"; labelloc="t"; fontsize=13;
node [shape=box, fontsize=10];
clients [label="clients\nPK client_id"];
departments [label="departments\nPK department_id"];
employees [label="employees\nPK employee_id"];
ticket_comments [label="ticket_comments\nPK ticket_comment_id"];
ticket_status_records [label="ticket_status_records\nPK status_id"];
tickets [label="tickets\nPK ticket_id"];
user_tickets [label="user_tickets\nPK user_ticket_id"];
user_tickets_comment [label="user_tickets_comment\nPK user_comment_ticket_id"];
user_tickets_status_record [label="user_tickets_status_record\nPK user_ticket_status_record_id"];
clients -> employees [label="admin_id"];
