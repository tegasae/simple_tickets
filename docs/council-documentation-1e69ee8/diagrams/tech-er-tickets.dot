ticket_comments -> tickets [label="ticket_id"];
ticket_status_records -> employees [label="actor_employee_id"];
ticket_status_records -> tickets [label="ticket_id"];
tickets -> departments [label="department_id"];
tickets -> user_tickets [label="user_ticket_id"];
tickets -> clients [label="client_id"];
user_tickets -> employees [label="contact_user_id"];
user_tickets -> clients [label="client_id"];
user_tickets -> employees [label="user_id"];
user_tickets_comment -> user_tickets [label="user_ticket_id"];
user_tickets_comment -> employees [label="employee_id"];
user_tickets_status_record -> employees [label="actor_employee_id"];
user_tickets_status_record -> user_tickets [label="user_ticket_id"];
}
