diff --git a/src/adapters/repositories/creation_result_repository.py b/src/adapters/repositories/creation_result_repository.py
new file mode 100644
index 0000000..aea9b7b
--- /dev/null
+++ b/src/adapters/repositories/creation_result_repository.py
@@ -0,0 +1,63 @@
+from src.adapters.repositories.base_repository import BaseRepository
+from src.adapters.repositories.exceptions import UniqueConstraintError
+from src.adapters.repositories.gateways.creation_result_gateway import CreationResultGateway
+from src.adapters.repositories.mappers.creation_result_mapper import CreationResultMapper
+from src.domain.repositories.creation_result_repository import (
+    CreationAlreadyReserved, CreationKey, CreationResult, CreationResultRepository,
+)
+from utils.db.connect import Connection
+
+
+class CreationResultRepositorySQLite(BaseRepository, CreationResultRepository):
+    def __init__(self, connection: Connection) -> None:
+        super().__init__(connection)
+
+    def get(self, key: CreationKey) -> CreationResult | None:
+        row = self._get_one(
+            CreationResultGateway.SELECT_BY_KEY,
+            var=CreationResultMapper.RESULT_COLUMNS,
+            params=CreationResultMapper.key_params(key),
+        )
+        return CreationResultMapper.row_to_result(row) if row else None
+
+    def reserve(self, key: CreationKey, *, fingerprint: str) -> None:
+        try:
+            self._exec(
+                CreationResultGateway.INSERT_RESERVATION,
+                CreationResultMapper.key_params(key, fingerprint=fingerprint),
+            )
+        except UniqueConstraintError as exc:
+            raise CreationAlreadyReserved() from exc
+
+    def complete(self, key: CreationKey, *, result: CreationResult) -> None:
+        written = self._exec(
+            CreationResultGateway.COMPLETE,
+            CreationResultMapper.completion_params(key, result),
+        )
+        if written.rowcount != 1:
+            raise RuntimeError("Expected one reserved creation result")
+
+    def forget_expired(self, key: CreationKey, *, now: float) -> None:
+        self._exec(
+            CreationResultGateway.DELETE_EXPIRED_BY_KEY,
+            CreationResultMapper.key_params(key, now=now),
+        )
+
+    def pending_deadlines(self) -> list[CreationKey]:
+        rows = self._get_many(
+            CreationResultGateway.SELECT_PENDING_DEADLINES,
+            var=CreationResultMapper.KEY_COLUMNS,
+        )
+        return [CreationResultMapper.row_to_key(row) for row in rows]
+
+    def set_deadline(self, key: CreationKey, *, expires_at: float) -> None:
+        self._exec(
+            CreationResultGateway.SET_DEADLINE,
+            CreationResultMapper.key_params(key, expires_at=expires_at),
+        )
+
+    def prune_expired(self, *, now: float) -> None:
+        self._exec(
+            CreationResultGateway.DELETE_EXPIRED,
+            CreationResultMapper.expiry_params(now),
+        )
diff --git a/src/adapters/repositories/gateways/creation_result_gateway.py b/src/adapters/repositories/gateways/creation_result_gateway.py
new file mode 100644
index 0000000..22d04a5
--- /dev/null
+++ b/src/adapters/repositories/gateways/creation_result_gateway.py
@@ -0,0 +1,39 @@
+class CreationResultGateway:
+    _KEY_FILTER = """
+        subject_type = :subject_type AND subject_id = :subject_id
+        AND command = :command AND idempotency_key = :key
+    """
+
+    SELECT_BY_KEY = f"""
+        SELECT fingerprint, status_code, body, expires_at
+        FROM creation_results WHERE {_KEY_FILTER}
+    """
+
+    INSERT_RESERVATION = """
+        INSERT INTO creation_results
+            (subject_type, subject_id, command, idempotency_key, fingerprint)
+        VALUES (:subject_type, :subject_id, :command, :key, :fingerprint)
+    """
+
+    COMPLETE = f"""
+        UPDATE creation_results SET status_code = :status_code, body = :body
+        WHERE {_KEY_FILTER} AND status_code IS NULL
+    """
+
+    DELETE_EXPIRED_BY_KEY = f"""
+        DELETE FROM creation_results WHERE {_KEY_FILTER} AND expires_at <= :now
+    """
+
+    SELECT_PENDING_DEADLINES = """
+        SELECT subject_type, subject_id, command, idempotency_key
+        FROM creation_results WHERE expires_at IS NULL AND status_code IS NOT NULL
+    """
+
+    SET_DEADLINE = f"""
+        UPDATE creation_results SET expires_at = :expires_at
+        WHERE {_KEY_FILTER} AND expires_at IS NULL AND status_code IS NOT NULL
+    """
+
+    DELETE_EXPIRED = """
+        DELETE FROM creation_results WHERE expires_at <= :now
+    """
diff --git a/src/adapters/repositories/mappers/creation_result_mapper.py b/src/adapters/repositories/mappers/creation_result_mapper.py
new file mode 100644
index 0000000..0af5de3
--- /dev/null
+++ b/src/adapters/repositories/mappers/creation_result_mapper.py
@@ -0,0 +1,44 @@
+from typing import Any
+
+from src.domain.repositories.creation_result_repository import CreationKey, CreationResult
+
+
+class CreationResultMapper:
+    RESULT_COLUMNS = ["fingerprint", "status_code", "body", "expires_at"]
+    KEY_COLUMNS = ["subject_type", "subject_id", "command", "idempotency_key"]
+
+    @staticmethod
+    def row_to_result(row: dict[str, Any]) -> CreationResult:
+        return CreationResult(
+            fingerprint=row["fingerprint"],
+            status_code=row["status_code"],
+            body=row["body"],
+            expires_at=row["expires_at"],
+        )
+
+    @staticmethod
+    def row_to_key(row: dict[str, Any]) -> CreationKey:
+        return CreationKey(
+            subject_type=row["subject_type"],
+            subject_id=row["subject_id"],
+            command=row["command"],
+            key=row["idempotency_key"],
+        )
+
+    @staticmethod
+    def key_params(key: CreationKey, **values: object) -> dict[str, object]:
+        return {
+            **values,
+            "subject_type": key.subject_type,
+            "subject_id": key.subject_id,
+            "command": key.command,
+            "key": key.key,
+        }
+
+    @classmethod
+    def completion_params(cls, key: CreationKey, result: CreationResult) -> dict[str, object]:
+        return cls.key_params(key, status_code=result.status_code, body=result.body)
+
+    @staticmethod
+    def expiry_params(now: float) -> dict[str, float]:
+        return {"now": now}
