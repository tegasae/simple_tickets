@@ -0,0 +1,74 @@
+import json
+from datetime import UTC, datetime
+
+from src.domain.repositories.refresh_session_repository import RefreshSession, SubjectType
+from utils.db.connect import Connection
+
+
+class RefreshSessionRepositorySQLite:
+    def __init__(self, connection: Connection) -> None:
+        self.connection = connection
+
+    def get(self, token_hash: str) -> RefreshSession | None:
+        with self.connection.create_query(
+            sql="""SELECT account_id, subject_id, subject_type, username,
+                          created_at, expires_at, scope
+                   FROM auth_refresh_sessions WHERE token_hash = :token_hash""",
+            params={"token_hash": token_hash},
+        ) as query:
+            row = query.get_one_result_tuple()
+        if not row:
+            return None
+        account_id, subject_id, subject_type, username, created_at, expires_at, scope = row
+        return RefreshSession(
+            account_id=account_id,
+            subject_id=subject_id,
+            subject_type=subject_type,
+            username=username,
+            created_at=datetime.fromtimestamp(created_at, UTC),
+            expires_at=datetime.fromtimestamp(expires_at, UTC),
+            scope=tuple(json.loads(scope)),
+        )
+
+    def add(self, token_hash: str, session: RefreshSession) -> None:
+        self._write(
+            """INSERT INTO auth_refresh_sessions
+               (token_hash, account_id, subject_id, subject_type, username,
+                created_at, expires_at, scope)
+               VALUES (:token_hash, :account_id, :subject_id, :subject_type, :username,
+                       :created_at, :expires_at, :scope)""",
+            {
+                "token_hash": token_hash,
+                "account_id": session.account_id,
+                "subject_id": session.subject_id,
+                "subject_type": session.subject_type,
+                "username": session.username,
+                "created_at": session.created_at.timestamp(),
+                "expires_at": session.expires_at.timestamp(),
+                "scope": json.dumps(session.scope),
+            },
+        )
+
+    def remove(self, token_hash: str) -> bool:
+        return self._write(
+            "DELETE FROM auth_refresh_sessions WHERE token_hash = :token_hash",
+            {"token_hash": token_hash},
+        ) == 1
+
+    def revoke_subject(self, *, subject_type: SubjectType, subject_id: int) -> None:
+        self._write(
+            """DELETE FROM auth_refresh_sessions
+               WHERE subject_type = :subject_type AND subject_id = :subject_id""",
+            {"subject_type": subject_type, "subject_id": subject_id},
+        )
+
+    def remove_expired(self, *, now: datetime) -> None:
+        self._write(
+            "DELETE FROM auth_refresh_sessions WHERE expires_at <= :now",
+            {"now": now.timestamp()},
+        )
+
+    def _write(self, sql: str, params: dict) -> int:
+        with self.connection.create_query(sql=sql, params=params) as query:
+            query.set_result()
+            return query.count
